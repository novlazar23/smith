APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

DATABASE_URL=postgresql://trading:trading@postgres:5432/trading
REDIS_URL=redis://redis:6379/0

LLM_BASE_URL=http://host.docker.internal:4000/v1
LLM_API_KEY=change-me
LLM_MODEL_FAST=local-fast
LLM_MODEL_MAIN=local-main
LLM_MODEL_CRITIC=local-critic

LIVE_EXECUTION_ENABLED=false
KILL_SWITCH_DEFAULT=true
RISK_POLICY_PATH=/app/config/risk-policy.yaml
POPULATION_POLICY_PATH=/app/config/population-policy.yaml

# Safe autonomous mode: Shadow/Paper only; LIVE_EXECUTION_ENABLED must stay false.
AUTONOMOUS_SHADOW_ENABLED=false
SHADOW_TRADING_ENABLED=false
SHADOW_TRADING_SYMBOLS=[]

# Portable encrypted runtime state. Set password and a unique ID only in local .env.
STATE_HANDOFF_ENABLED=false
STATE_HANDOFF_PASSWORD=
STATE_NODE_ID=
STATE_DATA_DIR=/app/data
STATE_BUNDLE_PATH=/app/handoff/runtime-state.enc.json
STATE_HANDOFF_LEASE_SECONDS=300
STATE_HANDOFF_SYNC_SECONDS=60
