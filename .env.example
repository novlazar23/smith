# =============================================================================
# Trading Orchestra — Environment Configuration
# =============================================================================
# Kopiere diese Datei zu .env und fülle die Werte.
# Nie die .env-Datei committen (.gitignore)!
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=trading-orchestra
APP_ENV=production
APP_SECRET_KEY=change-me-in-production

# ─── Database: PostgreSQL ────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading
DB_USER=orchestra
DB_PASSWORD=change-me-in-production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ─── Database: ClickHouse ────────────────────────────────────────────────────
CH_HOST=clickhouse
CH_PORT=8123
CH_DB=trading_events
CH_USER=orchestra
CH_PASSWORD=change-me-in-production
CH_SECURE=true

# ─── Database: Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-in-production
REDIS_MAX_CONNECTIONS=30

# ─── Streaming: Redpanda ─────────────────────────────────────────────────────
REDPANDA_SERVERS=localhost:9092

# ─── API ─────────────────────────────────────────────────────────────────────
API_SECRET_KEY=change-me-in-production
API_CORS_ORIGINS=https://your-domain.com
API_HOST=0.0.0.0
API_PORT=8000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
LOG_JSON=true

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000