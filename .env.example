APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

DATABASE_URL=postgresql://trading:trading@postgres:5432/trading
REDIS_URL=redis://redis:6379/0

LLM_BASE_URL=http://host.docker.internal:4000/v1
LLM_API_KEY=change-me
LLM_MODEL_FAST=local-fast
LLM_MODEL_MAIN=local-main
LLM_MODEL_CRITIC=local-critic

LIVE_EXECUTION_ENABLED=false
KILL_SWITCH_DEFAULT=true
RISK_POLICY_PATH=/app/config/risk-policy.yaml
POPULATION_POLICY_PATH=/app/config/population-policy.yaml

# InfluxDB (Time-Series) — Werte für den Docker-Betrieb; localhost-Variante für
# lokale Entwicklung: http://localhost:8086
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=influxdb-token-change-me
INFLUXDB_ORG=smith
INFLUXDB_BUCKET=market_data
INFLUXDB_ENABLED=true

# Shadow Trading (Simulations-Loop, standardmäßig deaktiviert)
SHADOW_TRADING_ENABLED=false
SHADOW_TRADING_SYMBOLS=BTCUSDT,ETHUSDT
