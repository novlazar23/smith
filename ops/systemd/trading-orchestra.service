# System-Unit für den Trading-Orchestra-Docker-Compose-Stack.
# Zweck: Der Stack startet automatisch nach einem Host-Reboot,
# wenn diese Unit aktiviert und gestartete ist.
#
# Installation: sudo bash ops/systemd/install_autostart.sh (siehe README.md)
# Entfernung:   sudo bash ops/systemd/install_autostart.sh --remove

[Unit]
Description=Trading Orchestra (Docker Compose stack)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/til/develop/smith
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
